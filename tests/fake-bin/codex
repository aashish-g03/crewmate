#!/usr/bin/env node
// Fake `codex` for tests: replays $FAKE_FIXTURE. See tests/fake-bin/README in AGENTS.md.
import fs from 'node:fs';
const argv = process.argv.slice(2);
const env = process.env;
if (argv[0] === '--version') { console.log('fake 0.0.0'); process.exit(0); }
if (argv[0] === 'debug' && argv[1] === 'models') {
  if (env.FAKE_MODELS_FAIL === '1') { process.stderr.write('error: catalog unavailable\n'); process.exit(1); }
  process.stdout.write(fs.readFileSync(env.FAKE_CODEX_MODELS ?? new URL('../fixtures/codex-debug-models.json', import.meta.url), 'utf8'));
  process.exit(0);
}
if (argv[0] === 'login' && argv[1] === 'status') { console.log('Logged in'); process.exit(Number(env.FAKE_LOGIN_EXIT ?? 0)); }
if (env.FAKE_PWD_FILE) fs.writeFileSync(env.FAKE_PWD_FILE, process.cwd());
if (env.FAKE_ARGV_LOG) fs.appendFileSync(env.FAKE_ARGV_LOG, JSON.stringify(argv) + '\n');
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const hang = () => setInterval(() => {}, 1 << 30);
import { spawn as spawnChild } from 'node:child_process';
if (env.FAKE_STDERR) process.stderr.write(env.FAKE_STDERR + '\n');
if (env.FAKE_GRANDCHILD_PID_FILE) {
  // A grandchild in our process group that ignores SIGTERM.
  const g = spawnChild('sh', ['-c', "trap '' TERM; sleep 37"], { stdio: 'ignore' });
  fs.writeFileSync(env.FAKE_GRANDCHILD_PID_FILE, String(g.pid));
}
if (env.FAKE_HANG === '1') hang();
else {
  const lines = env.FAKE_FIXTURE ? fs.readFileSync(env.FAKE_FIXTURE, 'utf8').split('\n').filter(Boolean) : [];
  const hangAfter = env.FAKE_HANG_AFTER === undefined ? Infinity : Number(env.FAKE_HANG_AFTER);
  const delay = Number(env.FAKE_DELAY_MS ?? 0);
  let i = 0;
  for (const line of lines) {
    if (i >= hangAfter) break;
    if (delay && i > 0) await sleep(delay);
    process.stdout.write(line + '\n');
    i++;
  }
  if (i < lines.length || hangAfter <= lines.length) hang();
  else {
    const o = argv.indexOf('-o');
    if (o >= 0) fs.writeFileSync(argv[o + 1], env.FAKE_ANSWER ?? 'done');
    if (env.FAKE_BACKGROUND_HOLD) spawnChild('sleep', [env.FAKE_BACKGROUND_HOLD], { stdio: ['ignore', 'inherit', 'inherit'] }).unref();
    process.exitCode = Number(env.FAKE_EXIT ?? 0); // not process.exit(): it drops stdout still queued for a pipe
  }
}
